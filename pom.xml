<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>demo.atomikos</groupId>
  <artifactId>j-xa-tester-atomikos-demo</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>inject fail-before-commit -&gt; watch Atomikos recover</name>
  <description>
    Demo built on https://github.com/rrobetti/j-xa-tester: a two-phase-commit
    transfer across two H2 databases, coordinated by Atomikos. j-xa-tester
    injects a one-shot XAException right before the commit call on one
    resource, the process is hard-killed to leave a genuinely in-doubt
    transaction in Atomikos' log, and a second JVM run shows Atomikos'
    crash recovery resolve it automatically on startup.
  </description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <xa-tester.version>0.1.0-alpha</xa-tester.version>
    <atomikos.version>6.0.1</atomikos.version>
    <jakarta.transaction-api.version>2.0.1</jakarta.transaction-api.version>
    <h2.version>2.4.240</h2.version>
    <slf4j.version>2.0.16</slf4j.version>
    <junit.version>5.13.4</junit.version>
  </properties>

  <dependencies>
    <!-- Transaction manager under test (jakarta.* classified build, for Jakarta EE 9+ compatibility) -->
    <dependency>
      <groupId>com.atomikos</groupId>
      <artifactId>transactions-jta</artifactId>
      <version>${atomikos.version}</version>
      <classifier>jakarta</classifier>
    </dependency>
    <dependency>
      <groupId>com.atomikos</groupId>
      <artifactId>transactions-jdbc</artifactId>
      <version>${atomikos.version}</version>
      <classifier>jakarta</classifier>
    </dependency>
    <dependency>
      <groupId>jakarta.transaction</groupId>
      <artifactId>jakarta.transaction-api</artifactId>
      <version>${jakarta.transaction-api.version}</version>
    </dependency>

    <!-- XA-capable database used as both enlisted resources -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
    </dependency>

    <!-- https://github.com/rrobetti/j-xa-tester : fault injection + timeline -->
    <dependency>
      <groupId>io.github.rrobetti</groupId>
      <artifactId>xa-tester-core</artifactId>
      <version>${xa-tester.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.rrobetti</groupId>
      <artifactId>xa-tester-jdbc</artifactId>
      <version>${xa-tester.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.rrobetti</groupId>
      <artifactId>xa-tester-timeline</artifactId>
      <version>${xa-tester.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.rrobetti</groupId>
      <artifactId>xa-tester-junit5</artifactId>
      <version>${xa-tester.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- so Atomikos' own recovery log lines are visible on the console -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>demo</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>copy-deps</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
